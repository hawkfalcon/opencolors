+/* smooth height glide for editor open/close. Unlike transforms, an animated
+   height participates in layout, so sibling strips slide along. Where WAAPI is
+   missing (jsdom) or motion is reduced, the DOM updates just apply instantly. */
+function animateHeight(el,from,to,ms){
+  if(!el.animate||from===to) return;
+  if(globalThis.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+  el.style.overflow='hidden'; // clip the panel while its box grows/shrinks
+  const anim=el.animate([{height:from+'px'},{height:to+'px'}],{duration:ms,easing:'cubic-bezier(.32,.72,0,1)'});
+  const clean=()=>el.style.removeProperty('overflow');
+  anim.onfinish=clean; anim.oncancel=clean;
+}
 /* remove the inline editor and restore the strip it was attached to */
 function teardownEditPanel(i){
   const panel=document.querySelector('.edit-panel'), x=document.querySelector('.ep-x');
-  if(panel) panel.remove();
   if(x) x.remove();
   const stripEl=document.querySelector('#strip-'+i);
+  const startH=stripEl?stripEl.offsetHeight:0;
+  if(panel) panel.style.display='none'; // hide first so the row height can be measured…
   if(stripEl) stripEl.classList.remove('editing');
   stripsEl.classList.remove('editing');
+  if(stripEl) animateHeight(stripEl,startH,stripEl.offsetHeight,260); // …then glide shut
+  if(panel) panel.remove();
   refreshStrip(i); syncHash();
 }
 function inlineDone(){
